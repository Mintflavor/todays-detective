# ==========================================
# 오늘의 탐정 (Today's Detective) - 환경변수 예시
# ==========================================

# ── 1. 프론트엔드 (Next.js 로컬 개발 시) ──
# same-origin /server/* 요청을 전달할 백엔드 주소 (기본값: http://todays-detective-api:8000)
# 로컬에서 FastAPI를 직접 띄워 개발할 경우: http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# ── 2. 백엔드 (FastAPI 로컬 실행 시) ──
# MongoDB 접속 URI (SCRAM 인증)
MONGODB_URL=mongodb://detective:your_password@localhost:27017/todays_detective?authSource=todays_detective
MONGODB_DATABASE=todays_detective

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-3.1-flash-lite-image

# 오브젝트 스토리지 (MinIO / S3 호환)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=todays-detective
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
PUBLIC_ASSET_BASE_URL=https://cdn.example.com/todays-detective

# 관리자 및 보안
ALLOWED_ORIGINS=http://localhost:3000
API_KEY_ADMIN=your_admin_api_key
ADMIN_PASSWORD=your_admin_password

# 레이트 리밋 (slowapi)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=mongodb://detective:your_password@localhost:27017/todays_detective?authSource=todays_detective
RATE_LIMIT_START_GLOBAL=5/hour;8/day;150/month
RATE_LIMIT_CHAT=300/hour
RATE_LIMIT_EVALUATE=20/hour
RATE_LIMIT_ADMIN_LOGIN=30/hour
